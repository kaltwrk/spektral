{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client", "../../../../packages/spektral/node_modules/@webgpu/types"],
		"skipLibCheck": true,
